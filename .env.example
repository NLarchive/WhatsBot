# WhatsApp API Configuration
API_URL=https://graph.facebook.com/v{VERSION}/{PHONE_NUMBER_ID}/messages
ACCESS_TOKEN=your_whatsapp_access_token_here
VERSION=v20.0
PHONE_NUMBER_ID=your_phone_number_id_here

# Application Information
APP_NAME=WhatsappVetbot
APP_ID=your_app_id_here
APP_SECRET=your_app_secret_here

# User Configuration
RECIPIENT_WAID=your_recipient_phone_number_here
VERIFY_TOKEN=your_webhook_verification_token_here

# AI Services
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_ASSISTANT_ID=your_openai_assistant_id_here
GOOGLE_API_KEY=your_google_api_key_here

# Ngrok Configuration
NGROK_AUTH_TOKEN=your_ngrok_auth_token_here